{
  "name": "TuxtlaResponde - Bot de Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "22222222-2222-4222-8222-222222222222"
    },
    {
      "parameters": {
        "dataPropertyName": "cmd",
        "rules": {
          "values": [
            {
              "conditions": [
                {
                  "leftValue": "={{ $json.message.text }}",
                  "rightValue": "/stats",
                  "operator": { "type": "string", "operation": "equals" }
                }
              ]
            },
            {
              "conditions": [
                {
                  "leftValue": "={{ $json.message.text }}",
                  "rightValue": "/reportes",
                  "operator": { "type": "string", "operation": "equals" }
                }
              ]
            },
            {
              "conditions": [
                {
                  "leftValue": "={{ $json.message.text }}",
                  "rightValue": "/resumen",
                  "operator": { "type": "string", "operation": "equals" }
                }
              ]
            }
          ]
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Detectar Comando",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://gateway:4000/api/transparency/stats",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Obtener Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, -120]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://gateway:4000/api/incidents",
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Obtener Reportes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://gateway:4000/api/ai/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "message", "value": "Resume qué está pasando en la ciudad" }
          ]
        },
        "options": {}
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Resumen IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 120]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=📊 *TuxtlaResponde*\nTotal: {{ $json.data.total_reports }} · Pendientes: {{ $json.data.pending_reports }} · En proceso: {{ $json.data.in_progress_reports }} · Resueltos: {{ $json.data.resolved_reports }} ({{ $json.data.resolved_rate }}% resueltos)",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "77777777-7777-4777-8777-777777777777",
      "name": "Enviar Stats",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [660, -120]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=📋 Hay {{ $json.total }} reportes aprobados. Últimos:\n{{ $json.data.slice(0, 5).map((r) => '• ' + r.title + ' (' + r.severity + ')').join('\\n') }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "88888888-8888-4888-8888-888888888888",
      "name": "Enviar Reportes",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🤖 {{ $json.data.reply }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "99999999-9999-4999-8999-999999999999",
      "name": "Enviar Resumen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Detectar Comando", "type": "main", "index": 0 }]] },
    "Detectar Comando": {
      "main": [
        [{ "node": "Obtener Stats", "type": "main", "index": 0 }],
        [{ "node": "Obtener Reportes", "type": "main", "index": 0 }],
        [{ "node": "Resumen IA", "type": "main", "index": 0 }]
      ]
    },
    "Obtener Stats": { "main": [[{ "node": "Enviar Stats", "type": "main", "index": 0 }]] },
    "Obtener Reportes": { "main": [[{ "node": "Enviar Reportes", "type": "main", "index": 0 }]] },
    "Resumen IA": { "main": [[{ "node": "Enviar Resumen", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
